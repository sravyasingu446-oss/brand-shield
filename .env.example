# ========================================================
# BrandShield AI — Example Environment Template (.env.example)
# Duplicate this file as .env and populate your secret keys:
# cp .env.example .env
# ========================================================

# OpenAI API Key (For Cognitive Threat Intelligence & Agent Reasoning)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# SerpAPI API Key (For Real-Time Web Search & Impersonation Discovery)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini API Key (Optional Alternative LLM Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Application Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./brandshield.db

# Risk Scoring Thresholds
HIGH_RISK_THRESHOLD=70
MEDIUM_RISK_THRESHOLD=40

# SecOps Defaults
DEFAULT_REVIEWER=SecOps Analyst (Tier 2)
